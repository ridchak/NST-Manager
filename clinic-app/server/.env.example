DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="change-this-to-a-strong-random-secret"
PORT=4000
CLIENT_URL=http://localhost:5173

# RingCentral Office@Hand
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_SERVER_URL=https://platform.ringcentral.com
RC_USERNAME=
RC_PASSWORD=
RC_EXTENSION=

# eClinicalWorks
ECW_BASE_URL=
ECW_USERNAME=
ECW_PASSWORD=

# Phone assistant (NexHealth Synchronizer + voice platform)
ASSISTANT_API_KEY=            # long random string; the voice platform sends it as x-assistant-key
CLINIC_NAME="Premier Weight Management and Lifestyle"
# Practice hours, address, phone and fax are managed in the app (Settings > Practice) by a superuser.
# OFFICE_HOURS / OFFICE_TZ below are an optional override; leave them blank normally.
# OFFICE_HOURS="Mon 08:00-17:00; Tue 08:00-16:00; Thu 08:00-17:00; Fri 08:00-16:00; Sat 09:00-15:00"
# OFFICE_TZ=America/Chicago
FRONT_DESK_NUMBER=            # a DIRECT line or extension for transfers to a person, e.g. +15551234567.
                              # It must NOT be the main number the assistant answers, or transfers would loop.
PRESCRIBER_TRANSFERS=         # optional JSON: {"<nexhealth provider id>":{"name":"Dr. X","extension":"101","cell":"+1555..."}}
STAFF_EMAIL=                  # optional; notification contains no clinical detail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RC_SMS_FROM=                  # SMS-enabled Office@Hand number used to send texts

# NexHealth Synchronizer (leave blank to run against the app's own database)
NEXHEALTH_API_KEY=
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_LOCATION_ID=
NEXHEALTH_PROVIDER_IDS=       # comma-separated provider ids that can be booked
NEXHEALTH_APPT_TYPE_NEW=
NEXHEALTH_APPT_TYPE_FOLLOWUP=

# Sign-in lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# Set to 1 when hosted behind a proxy/load balancer so the audit log records real client addresses
TRUST_PROXY=
